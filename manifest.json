{
  "manifest_version": 3,
  "name": "ResumePilot 简历机器人",
  "version": "0.0.2",
  "description": "本地保存求职资料，解析招聘页面结构并安全填写当前页。",
  "icons": {
    "16": "icons/chrome-16.png",
    "32": "icons/chrome-32.png",
    "48": "icons/chrome-48.png",
    "128": "icons/chrome-128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "profile.html",
  "action": {
    "default_title": "ResumePilot 简历机器人",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/chrome-16.png",
      "32": "icons/chrome-32.png",
      "48": "icons/chrome-48.png",
      "128": "icons/chrome-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["profile-schema.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
