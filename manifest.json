{
  "manifest_version": 3,
  "name": "简历一键填表 MVP",
  "version": "0.6.50",
  "description": "本地解析并保存简历，将求职资料和简历附件一键写入常见招聘表单；不会自动提交。",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "debugger"],
  "optional_host_permissions": ["http://llm.api.corp.qunar.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "简历一键填表",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
